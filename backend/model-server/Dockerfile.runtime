# Build with PYTORCH_BASE_IMAGE set to an immutable image reference:
# pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime@sha256:<verified-64-hex-digest>
ARG PYTORCH_BASE_IMAGE
FROM ${PYTORCH_BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_DATASETS_OFFLINE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/astra
COPY requirements-runtime.txt ./
RUN python -m pip install --no-cache-dir -r requirements-runtime.txt \
    && python -m pip check \
    && python -c "import torch; assert torch.__version__.split('+')[0] == '2.5.1'; assert torch.version.cuda and torch.version.cuda.startswith('12.4')"

COPY runtime_errors.py runtime_manifest.py runtime_registry.py ./
COPY sd35_adapter.py wan21_adapter.py astra_sandbox_entrypoint.py ./
RUN python -m py_compile runtime_errors.py runtime_manifest.py runtime_registry.py sd35_adapter.py wan21_adapter.py astra_sandbox_entrypoint.py \
    && python -c "import astra_sandbox_entrypoint, diffusers, transformers; print('ASTRA runtime imports OK')"

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin astra
USER 10001:10001
WORKDIR /tmp

# The parent executor supplies the exact entrypoint command and bounded stdin.
